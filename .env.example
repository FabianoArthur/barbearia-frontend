# Base URL of the REST API (the backend lives in a separate repository).
VITE_API_URL=http://localhost:3000/api

# Google reCAPTCHA v3 *site* key. Only used when VITE_ENV=production.
VITE_RECAPTCHA_SITE_KEY=

# "production" enables reCAPTCHA on the public booking flow.
VITE_ENV=development

# "true" runs the app against an in-memory mock API (no backend needed).
# This is how the GitHub Pages demo is built.
VITE_DEMO=false
